# Dockerfile otimizado para Railway - AI Cover Studio
FROM python:3.10-slim-bookworm

# Variáveis de ambiente
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV GRADIO_SERVER_NAME=0.0.0.0
ENV PORT=7860

# Instalar dependências mínimas do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Criar diretório de trabalho
WORKDIR /app

# Copiar e instalar dependências Python
COPY requirements-railway.txt .
RUN pip install -r requirements-railway.txt

# Copiar código
COPY ai_cover_app.py audio_separator.py audio_mixer.py voice_converter.py clonar_voz.py ./

# Criar diretórios
RUN mkdir -p models datasets output

# Expor porta
EXPOSE 7860

# Comando
CMD ["python", "ai_cover_app.py"]
